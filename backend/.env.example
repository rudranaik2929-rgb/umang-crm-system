SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
# Comma-separated CRM frontend origins (login cookies / CORS). Defaults include umanghometechllp.in if unset.
CORS_ORIGINS=https://umanghometechllp.in,https://www.umanghometechllp.in
# Optional regex fallback (defaults cover www + apex + Vercel + localhost)
# CORS_ORIGIN_REGEX=^https://(www\.)?umanghometechllp\.in$
FRONTEND_URL=https://umanghometechllp.in
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=240
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=120

# --- Login OTP (every sign-in code is emailed to the ADMIN mailbox) ----------
# Admin and employees all pass a one-time code. The code NEVER goes to the
# address the person typed — it always goes to OTP_EMAIL.
OTP_EMAIL=Umanghometechllp@gmail.com
# Set OTP_LOGIN_ENABLED=false only as an emergency escape hatch (turns OTP off).
OTP_LOGIN_ENABLED=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Mail transport — Gmail App Password (recommended, no domain needed).
# Create at https://myaccount.google.com/apppasswords for the sending Gmail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Umanghometechllp@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
# SMTP_FROM defaults to SMTP_USER
# Alternative provider: set RESEND_API_KEY instead of SMTP_* (and RESEND_FROM)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Umang Properties CRM <onboarding@resend.dev>

FACEBOOK_VERIFY_TOKEN=UMANGCRM123
# Required for Meta leads to appear — Page access token with leads_retrieval (webhook alone is not enough)
FACEBOOK_PAGE_ACCESS_TOKEN=your-meta-page-access-token
# Your Facebook Page numeric id (Meta Business Suite → Page → About)
FACEBOOK_PAGE_ID=
FACEBOOK_FORM_ID=
FACEBOOK_GRAPH_VERSION=v20.0
# Auto-retry failed Meta webhooks + import last 24h of Lead Ad forms (every 15 min)
FACEBOOK_AUTO_SYNC_ENABLED=true
FACEBOOK_AUTO_SYNC_INTERVAL_SEC=900
FACEBOOK_AUTO_SYNC_WINDOW_SEC=7200

HOUSING_PROFILE_ID=2548773
HOUSING_ENCRYPTION_KEY=your-housing-encryption-key
HOUSING_INTEGRATION_UUID=your-housing-integration-uuid
HOUSING_WEBHOOK_SECRET=your-housing-integration-uuid
HOUSING_API_URL=https://leads.housing.com/api/v0/get-builder-leads

INTERAKT_API_KEY=
OPENAI_API_KEY=

