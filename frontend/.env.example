# Frontend — production API
EXPO_PUBLIC_BACKEND_URL=https://umang-crm-systemumang-home-tech.onrender.com

# Google Maps JavaScript API (Employee Tracking map only — enable Maps JavaScript API)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase Realtime (instant in-app notifications)
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Firebase Web Push (Android Chrome + PWA) — from Firebase Console → Project settings → Web app
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_VAPID_KEY=   # Cloud Messaging → Web Push certificates
